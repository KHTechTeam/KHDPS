           </font>
          </property>
          <property name="styleSheet">
           <string notr="true">/* the track */
QSlider::groove:horizontal {
    background: #e0e0e0;
    height: 4px;
    border-radius: 4px;
}

/* the filled portion to the left of the handle (Qt 6+) */
QSlider::sub-page:horizontal {
    background: rgb(45,101,163);
    border-radius: 15px;
}

/* the unfilled portion to the right of the handle (Qt 6+) */
QSlider::add-page:horizontal {
    background: #e0e0e0;
    border-radius: 4px;
}

/* the thumb */
QSlider::handle:horizontal {
    background: rgb(45,101,163);
    width: 12px;
    height: 12px;         /* improves hit area */
    margin: -4px 0;       /* centers handle on the 8px groove */
    border-radius: 6px;
}

/* hover/pressed feedback (optional) */
QSlider::handle:horizontal:hover   { background: rgb(45,101,163); }
QSlider::handle:horizontal:pressed { background: rgb(45,101,163) }</string>
          </property>
